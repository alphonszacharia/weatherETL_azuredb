{
  "datasets": [
    {
      "name": "weather_summary",
      "displayName": "Weather Summary",
      "config": {
        "version": "1.1",
        "source": "adb_ws.gold.weather_summary",
        "dimensions": [
          {
            "expr": "location"
          },
          {
            "expr": "weather_date"
          }
        ],
        "measures": [
          {
            "name": "avg_temperature",
            "expr": "AVG(avg_temperature)"
          },
          {
            "name": "max_temperature",
            "expr": "MAX(max_temperature)"
          },
          {
            "name": "min_temperature",
            "expr": "MIN(min_temperature)"
          },
          {
            "name": "avg_humidity",
            "expr": "AVG(avg_humidity)"
          },
          {
            "name": "total_rainfall",
            "expr": "SUM(total_rainfall)"
          },
          {
            "name": "avg_wind_speed",
            "expr": "AVG(avg_wind_speed)"
          },
          {
            "name": "avg_cloud_cover",
            "expr": "AVG(avg_cloud_cover)"
          }
        ]
      }
    }
  ],
